# ==============================================================================
# TRACEVIDENCE Backend Environment Configuration
# ==============================================================================

# API Keys for AI & Retrieval Engines
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# Database Configuration (PostgreSQL or fallback SQLite)
DATABASE_URL=postgresql://tracevidence:tracevidence@localhost:5432/tracevidence_db
# For SQLite fallback during local development:
# DATABASE_URL=sqlite:///./tracevidence.db

# Redis & Celery (Optional background task queue)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Server Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:3000"]
