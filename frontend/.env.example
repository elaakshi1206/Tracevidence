# ==============================================================================
# TRACEVIDENCE Frontend Environment Configuration
# ==============================================================================

# Backend FastAPI Service URL
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# AI Foundation Models
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# Evidence Retrieval & Search Engines
# Note: OpenAlex, Crossref, arXiv, GDELT 2.0, Wikipedia, and Jina Reader work
# 100% out of the box with ZERO API keys required!
# ------------------------------------------------------------------------------
TAVILY_API_KEY=your_tavily_api_key_here
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here
NEWS_API_KEY=your_newsapi_key_here
SERPER_API_KEY=your_serper_google_key_here
EXA_API_KEY=your_exa_neural_key_here

# Deep Full-Page Crawl & Scrape (Jina Reader works keyless; Firecrawl optional)
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
JINA_API_KEY=your_optional_jina_key_here

# Database Configuration
DATABASE_URL=postgresql://tracevidence:tracevidence@localhost:5432/tracevidence_db

# Next.js App Environment
NEXT_PUBLIC_APP_ENV=development

